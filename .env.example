VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Referencia pública del proyecto Supabase (no es una contraseña).
SUPABASE_PROJECT_REF=xbeuigtcwsglxhtzpacd

# Server-only key. Do not expose it with VITE_.
ZAI_API_KEY=
ZAI_MODEL=glm-5.2
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4


# Sincronizacion con la planilla de Google (solo servidor, sin VITE_).
# Sin estas variables la app funciona igual, pero no escribe en el Excel.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
# Opcional: nombre de la hoja. Vacio = la primera hoja del documento.
GOOGLE_SHEET_NAME=

# Rutina diaria (/api/daily, programada en vercel.json). Ver docs/tareas-diarias.md.
# Sin CRON_SECRET la rutina no corre.
CRON_SECRET=
# Opcional: para recibir el resumen del dia por Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_URL=

# Entrada automatica de leads (/api/lead-intake). Ver docs/leads-automaticos.md.
# Sin esta clave la entrada no acepta nada.
LEAD_INTAKE_SECRET=

# Lectura de boletos con IA (Anthropic). Sin esta clave la pagina Boletos no puede analizar archivos.
ANTHROPIC_API_KEY=
# BOLETO_MODEL=claude-sonnet-5-5 (por defecto). Mas barato: claude-haiku-5-5. Fotos muy malas: claude-opus-5-5
# ANTHROPIC_WORKSPACE_ID= (solo si la clave no esta creada dentro de un workspace)
